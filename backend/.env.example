OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TYPESAFE_API_KEY=
DB_NAME=review
DB_USERNAME=review
DB_PASSWORD=review
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/review
DEV_TOOLS_ENABLED=true
DEV_TOOLS_TOKEN=
API_DOCS_ENABLED=true

# 로그인 (스펙 §7.9). 키가 없는 제공자는 꺼진다. redirect URI: http://localhost:8080/login/oauth2/code/{google|kakao}
PUBLIC_SERVER_URL=http://localhost:8080
APP_URL=http://localhost:8081
# 비우면 시작할 때마다 임시 키(재시작하면 로그아웃). 만들기: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | base64 | tr -d '\n'
AUTH_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오 REST API 키. Client Secret은 콘솔에서 켰을 때만
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
