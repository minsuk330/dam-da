# 서버 배포용. 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
DOMAIN=hack.refit-100.site
# GitHub Actions(backend-image)가 올린 이미지. 비우면 서버에서 직접 빌드한다.
APP_IMAGE=ghcr.io/minsuk330/ku-hack-backend:latest
# 앱이 받는 호스트 루프백 포트(nginx proxy_pass 대상). 다른 서비스와 겹치지 않게.
APP_PORT=18080

# PostgreSQL (compose 내부 네트워크에서만 접속). 비밀번호는 길고 무작위로.
DB_NAME=review
DB_USERNAME=review
DB_PASSWORD=

# LLM·Jev
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TYPESAFE_API_KEY=

# 시간 이동 데모용 /dev/**. 원격 호출은 X-Dev-Token 헤더가 이 값과 같을 때만 허용된다.
# 만들기: openssl rand -hex 32
DEV_TOOLS_ENABLED=true
DEV_TOOLS_TOKEN=

# 배포 서버에서는 API 문서를 열지 않는다.
API_DOCS_ENABLED=false
# 프론트(Vercel)는 rewrites로 같은 출처에서 부르므로 CORS를 열지 않는다.
CORS_ALLOWED_ORIGINS=

# 로그인 (스펙 §7.9). 구글·카카오 콘솔 redirect URI: https://<DOMAIN>/login/oauth2/code/{google|kakao}
PUBLIC_SERVER_URL=https://hack.refit-100.site
# 로그인 후 돌아갈 프론트(Vercel) 주소. {APP_URL}/auth/callback
APP_URL=
# 반드시 넣는다(비우면 재시작할 때 모두 로그아웃). 만들기: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 | tr -d '\n'
AUTH_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
