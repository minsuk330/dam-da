# 호스트 nginx 사이트 예시: /etc/nginx/sites-available/hack.refit-100.site
# 링크 후 인증서: certbot --nginx -d hack.refit-100.site --redirect
server {
    listen 80;
    server_name hack.refit-100.site;

    # 대화 원문(붙여넣기)이 길 수 있다.
    client_max_body_size 10m;

    # API 문서는 배포 서버에서 열지 않는다(API_DOCS_ENABLED=false와 이중 차단).
    location ~ ^/(v3/api-docs|swagger-ui) {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /mcp(Streamable HTTP) 스트리밍 응답을 버퍼링 없이 넘긴다.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
