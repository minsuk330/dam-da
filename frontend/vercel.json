{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://hack.refit-100.site/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
